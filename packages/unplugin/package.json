{
    "name": "env-attr-cleaner",
    "version": "1.0.7",
    "description": "Universal plugin to strip data-* attributes from production builds",
    "author": "techmefr",
    "license": "MIT",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "type": "module",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "keywords": [
        "unplugin",
        "vite",
        "webpack",
        "rollup",
        "esbuild",
        "nuxt",
        "nextjs",
        "data-attributes",
        "testing",
        "e2e",
        "playwright",
        "cypress"
    ],
    "homepage": "https://github.com/techmefr/env-attr-cleaner/tree/main/packages/unplugin#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/techmefr/env-attr-cleaner.git",
        "directory": "packages/unplugin"
    },
    "bugs": {
        "url": "https://github.com/techmefr/env-attr-cleaner/issues"
    },
    "scripts": {
        "build": "unbuild",
        "test": "vitest run --coverage",
        "typecheck": "tsc --noEmit -p tsconfig.test.json"
    },
    "dependencies": {
        "magic-string": "^1.3.1",
        "unplugin": "^3.3.0"
    },
    "peerDependencies": {
        "esbuild": ">=0.18.0",
        "next": ">=13.0.0",
        "rollup": ">=3.0.0",
        "vite": ">=4.0.0",
        "webpack": ">=4.0.0"
    },
    "peerDependenciesMeta": {
        "esbuild": {
            "optional": true
        },
        "next": {
            "optional": true
        },
        "rollup": {
            "optional": true
        },
        "vite": {
            "optional": true
        },
        "webpack": {
            "optional": true
        }
    },
    "devDependencies": {
        "typescript": "^5.9.3",
        "unbuild": "^3.0.0",
        "vite": "^8.3.0",
        "vitest": "^5.0.0"
    }
}
