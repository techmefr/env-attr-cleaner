{
    "name": "env-attr-cleaner-monorepo",
    "version": "1.0.7",
    "private": true,
    "description": "Strip data-* attributes from production builds",
    "author": "techmefr",
    "license": "MIT",
    "homepage": "https://github.com/techmefr/env-attr-cleaner#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/techmefr/env-attr-cleaner.git"
    },
    "bugs": {
        "url": "https://github.com/techmefr/env-attr-cleaner/issues"
    },
    "scripts": {
        "build": "pnpm -r build",
        "test": "pnpm -r test",
        "typecheck": "pnpm -r typecheck",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "simple-git-hooks",
        "release": "node scripts/release.mjs"
    },
    "simple-git-hooks": {
        "commit-msg": "node_modules/.bin/commitlint --edit $1"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@vitest/coverage-v8": "^5.1.2",
        "changelogen": "^0.6.2",
        "prettier": "^3.10.1",
        "simple-git-hooks": "^2.14.0",
        "typescript": "^5.9.3"
    },
    "packageManager": "pnpm@9.0.0",
    "engines": {
        "node": ">=18.0.0",
        "pnpm": ">=9.0.0"
    },
    "pnpm": {
        "overrides": {
            "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
            "simple-git@<4.0.1": "^4.0.1",
            "@nuxt/devtools@<3.3.1": "^3.3.1",
            "@simple-git/argv-parser@<2.0.1": "^2.0.1"
        }
    }
}
